{
  "name": "@fambot/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode prod",
    "preview": "vite preview",
    "tauri": "tauri",
    "ios": "tauri ios dev",
    "ios:device": "tauri ios dev --host",
    "ios:open": "tauri ios dev --open",
    "ios:build": "tauri ios build",
    "ios:build:store": "VITE_APNS_ENV=production tauri ios build --export-method app-store-connect",
    "ios:init": "rustup target add aarch64-apple-ios x86_64-apple-ios aarch64-apple-ios-sim && tauri ios init",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fambot/shared": "workspace:*",
    "@spicavi/tauri-plugin-push-notifications": "0.1.0",
    "@tauri-apps/plugin-notification": "^2.3.1",
    "@fontsource-variable/outfit": "^5.2.0",
    "@fontsource/fira-code": "^5.2.0",
    "@fontsource/merriweather": "^5.2.0",
    "@tanstack/react-query": "^5.66.0",
    "better-auth": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.4.2",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}