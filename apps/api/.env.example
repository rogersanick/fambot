# Fambot API — copy to .env for local dev
DATABASE_URL=postgres://postgres:fambot@localhost:5433/fambot
PORT=8787
API_BASE_URL=http://localhost:8787
APP_URL=http://localhost:5173

BETTER_AUTH_SECRET=dev-secret-change-me-in-production-0000
BRIDGE_TOKEN=dev-bridge-token
TOKEN_ENCRYPTION_KEY=dev-encryption-key-change-in-prod!!

# Required — the API refuses to start without it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Google OAuth (sign-in + calendar). Leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
