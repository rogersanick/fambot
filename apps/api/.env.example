# Fambot API — copy to .env for local dev
DATABASE_URL=postgres://postgres:fambot@localhost:5433/fambot
PORT=8787
API_BASE_URL=http://localhost:8787
APP_URL=http://localhost:5173

BETTER_AUTH_SECRET=dev-secret-change-me-in-production-0000
BRIDGE_TOKEN=dev-bridge-token
TOKEN_ENCRYPTION_KEY=dev-encryption-key-change-in-prod!!
# Signs short-lived delegated tokens for the /mcp tool endpoint
MCP_SIGNING_SECRET=dev-mcp-signing-secret-change-me-000

# Required for AI-backed chat; auth and CRUD still work without it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Google OAuth (sign-in + calendar). Leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telnyx SMS — the default notification channel for reminders and task nudges.
# For a Telnyx account with exactly one profile-backed number, bun dev discovers
# the remaining values, opens a webhook tunnel, and configures the profile.
# Set the optional values explicitly when the account has multiple numbers.
TELNYX_API_KEY=
# Base64 Ed25519 public key from the Telnyx portal (webhook signatures)
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
# E.164 number owned by your messaging profile, e.g. +15551234567
TELNYX_FROM_NUMBER=
# Optional stable public tunnel URL; otherwise bun dev creates a quick tunnel.
TELNYX_WEBHOOK_URL=
