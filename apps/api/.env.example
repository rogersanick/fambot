# Fambot API — local dev. Prefer `bun run env:setup` over copying this by hand.
DATABASE_URL=postgres://postgres:fambot@localhost:5433/fambot
PORT=8787
API_BASE_URL=http://localhost:8787
APP_URL=http://localhost:5173

BETTER_AUTH_SECRET=dev-secret-change-me-in-production-0000
BRIDGE_TOKEN=dev-bridge-token
TOKEN_ENCRYPTION_KEY=dev-encryption-key-change-in-prod!!
MCP_SIGNING_SECRET=dev-mcp-signing-secret-change-me-000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM_NUMBER=

# APNs (iOS app push). Set team/key ids and EITHER paste the .p8 contents
# (base64 ok) as APNS_PRIVATE_KEY or point APNS_PRIVATE_KEY_PATH at the file;
# `bun run env:setup` inlines the path as base64 everywhere. Never commit the .p8.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=app.fambot.desktop
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=
