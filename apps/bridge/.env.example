# Fambot Mac bridge — copy to .env, or run `bun run env:setup`.
# bun bridge:dev uses API_URL + BRIDGE_TOKEN.
# bun bridge:prod uses apps/bridge/.env.prod against Fly.
API_URL=http://localhost:8787
PROD_API_URL=https://fambot-nrogers.fly.dev
BRIDGE_TOKEN=dev-bridge-token
# BRIDGE_EMAIL=
# BRIDGE_PASSWORD=
IMSG_BIN=imsg
BOT_MESSAGE_PREFIX=Fambot says: 🤖✨
STATE_PATH=./data/state.json
FAMBOT_PROFILE=local-dev
