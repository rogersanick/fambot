# Fambot Mac bridge — copy to .env
API_URL=http://localhost:8787
BRIDGE_TOKEN=dev-bridge-token
IMSG_BIN=imsg
BOT_MESSAGE_PREFIX=Fambot says: 🤖✨
STATE_PATH=./data/state.json
# production: skip all is_from_me messages; local-dev: treat un-prefixed
# self-messages as user input (bot + human share one Apple ID)
FAMBOT_PROFILE=production
