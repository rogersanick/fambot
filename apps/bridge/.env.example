# Fambot Mac bridge — copy to .env
# bun dev uses API_URL + BRIDGE_TOKEN (no prompt).
# bun bridge:local / bun bridge:prod ping the target, then prompt for a
# household-owner email/password (or set BRIDGE_EMAIL + BRIDGE_PASSWORD).
API_URL=http://localhost:8787
PROD_API_URL=https://fambot.fly.dev
BRIDGE_TOKEN=dev-bridge-token
# BRIDGE_EMAIL=
# BRIDGE_PASSWORD=
IMSG_BIN=imsg
BOT_MESSAGE_PREFIX=Fambot says: 🤖✨
STATE_PATH=./data/state.json
