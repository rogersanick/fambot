{
  "name": "@fambot/bridge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file .env --watch src/index.ts",
    "start": "bun --env-file .env src/index.ts",
    "start:local": "bun --env-file .env src/index.ts --target local",
    "start:prod": "bun --env-file .env.prod src/index.ts --target prod",
    "start:interactive": "bun src/index.ts --interactive",
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bun-types": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
