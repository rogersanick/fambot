# ── FamBot edge functions configuration ─────────────────────────────
# Copy to supabase/functions/.env and pass with:
#   supabase functions serve --env-file supabase/functions/.env
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically
#  by `supabase functions serve` / hosted Supabase.)

# Deployment profile: local-dev | production
FAMBOT_PROFILE=local-dev

# Portal base URL for deep links (last line of every bot reply)
APP_BASE_URL=http://localhost:3000

# LLM provider (any OpenAI-compatible chat-completions endpoint).
# Swap LLM_BASE_URL to point at a local server (e.g. Osaurus) later.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-2024-08-06

# local-dev only: prefix prepended to every outbound message
BOT_MESSAGE_PREFIX=Fambot says: 🤖✨
