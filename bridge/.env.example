# ── FamBot bridge worker configuration ──────────────────────────────
# Copy to .env and fill in. Values shown are the local-dev defaults.

# Deployment profile: local-dev | production
FAMBOT_PROFILE=local-dev

# imsg binary (https://imsg.sh) — spawned as `imsg rpc` and supervised by the
# bridge. Default resolves from PATH; set an absolute path if needed.
IMSG_BIN=imsg

# Supabase edge functions base URL
# local-dev: http://127.0.0.1:54321/functions/v1
SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

# Bridge identity — must match a row in the bridges table.
# BRIDGE_SECRET is the plaintext secret whose SHA-256 hash is stored in bridges.secret_hash.
BRIDGE_ID=00000000-0000-0000-0000-000000000001
BRIDGE_SECRET=local-dev-bridge-secret

# local-dev only: comma-separated chat GUIDs the bridge is allowed to process.
# Every other chat is ignored entirely and never buffered.
# Find GUIDs via: imsg chats --limit 20 --json | jq -r '.guid'
CHAT_ALLOWLIST=

# local-dev only: prefix prepended to every outbound bot message.
# Doubles as loop prevention because the bot shares the developer's identity.
BOT_MESSAGE_PREFIX=Fambot says: 🤖✨

# SQLite spool location (created on first run)
SPOOL_PATH=./data/spool.sqlite
