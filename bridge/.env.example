# ── FamBot bridge configuration ─────────────────────────────────────
# Copy to .env. The bridge is the always-on process on your Mac: it watches
# iMessage via imsg, invokes your agent on @fambot messages, and delivers
# due reminders.

FAMBOT_PROFILE=local-dev
# Use an absolute path (`which imsg`) if imsg isn't on this process's PATH,
# e.g. /Users/you/.local/bin/imsg
IMSG_BIN=imsg

# Only these chat GUIDs are processed in local-dev. imsg emits NDJSON
# (one JSON object per line). Find yours with:
#   imsg chats --limit 20 --json | jq -r '[.guid, .name] | @tsv'
CHAT_ALLOWLIST=

# Replies are prefixed so the bridge can tell its own messages apart from
# yours (you share one iMessage identity in local-dev).
BOT_MESSAGE_PREFIX=Fambot says: 🤖✨
# Extra invocation name besides @fambot (optional), e.g. jarvis
BOT_NAME=fambot

# Watch-cursor state file (replays messages missed while the bridge was down).
STATE_PATH=./data/state.json

# ── Supabase (the agent's identity) ─────────────────────────────────
# Anon key from `npx supabase status`. The bridge signs in as the agent user
# created by scripts/bootstrap-local.mjs; RLS scopes everything it can do.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
AGENT_EMAIL=agent@fambot.local
AGENT_PASSWORD=fambot-agent

# ── FamBot MCP server (served by the Next.js app) ───────────────────
MCP_URL=http://localhost:3000/mcp

# ── Agent adapter ────────────────────────────────────────────────────
# "openai": the bridge drives a tool-calling loop against any
#           OpenAI-compatible endpoint (osaurus, LM Studio, ...).
# "cli":    the bridge shells out to AGENT_CMD; prompt on stdin, reply on
#           stdout, FAMBOT_MCP_URL/FAMBOT_MCP_TOKEN in env (Claude Code etc).
AGENT_MODE=openai
AGENT_TIMEOUT_MS=120000

# openai mode (osaurus default port shown; check with `osaurus status`)
OPENAI_BASE_URL=http://127.0.0.1:1337/v1
OPENAI_MODEL=
OPENAI_API_KEY=

# cli mode example (Claude Code):
#   AGENT_CMD=claude -p --strict-mcp-config --mcp-config "$FAMBOT_MCP_CONFIG" --allowedTools "mcp__fambot__*"
AGENT_CMD=

# ── Reminders ────────────────────────────────────────────────────────
REMINDER_POLL_MS=30000
